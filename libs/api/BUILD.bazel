cc_library(
    name = "api",
    hdrs = glob([
        "include/rtbot_sql/api/types.h",
        "include/rtbot_sql/api/unreachable.h",
        "include/rtbot_sql/version.h",
    ]),
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        "//libs/parser",
    ],
)

cc_library(
    name = "batch_decoder",
    hdrs = ["include/rtbot_sql/api/batch_decoder.h"],
    srcs = ["src/batch_decoder.cpp"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        "@rtbot//libs/api:rtbot-api",
    ],
)

cc_library(
    name = "api_compiler",
    hdrs = ["include/rtbot_sql/api/compiler.h"],
    srcs = ["src/compiler.cpp"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
    deps = [
        ":api",
        ":api_preprocessor",
        "//libs/analyzer",
        "//libs/catalog",
        "//libs/compiler",
        "//libs/parser",
        "//libs/planner",
    ],
)

cc_library(
    name = "api_preprocessor",
    hdrs = ["include/rtbot_sql/api/preprocessor.h"],
    srcs = ["src/preprocessor.cpp"],
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)

cc_test(
    name = "version_test",
    srcs = ["src/version_test.cpp"],
    deps = [
        ":api",
        "@com_google_googletest//:gtest_main",
    ],
)
