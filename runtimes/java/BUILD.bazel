java_library(
    name = "rtbot-sql-java-native-empty",
    srcs = [],
    visibility = ["//visibility:public"],
)

alias(
    name = "rtbot-sql-java-native-host",
    actual = select({
        ":is_linux_x86_64": ":rtbot-sql-java-native-linux-x86_64",
        ":is_linux_aarch64": ":rtbot-sql-java-native-linux-aarch64",
        ":is_macos_x86_64": ":rtbot-sql-java-native-mac-x86_64",
        ":is_macos_aarch64": ":rtbot-sql-java-native-mac-aarch64",
        ":is_windows_x86_64": ":rtbot-sql-java-native-win-x86_64",
        ":is_windows_aarch64": ":rtbot-sql-java-native-win-aarch64",
        "//conditions:default": ":rtbot-sql-java-native-empty",
    }),
)

java_library(
    name = "rtbot-sql-java-runtime",
    srcs = [],
    exports = [":rtbot-sql-java"],
    runtime_deps = [":rtbot-sql-java-native-host"],
    visibility = ["//visibility:public"],
)

