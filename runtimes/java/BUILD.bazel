load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_java//java:defs.bzl", "java_library", "java_test")

package(default_visibility = ["//visibility:public"])

# ---------------------------------------------------------------------------
# JNI shared library — SQL compiler + pipeline execution
#
# Compiles rtbot_sql_jni.cpp against the RTBot SQL compiler API, the RTBot
# core API (for Program / VectorNumberData), nlohmann/json, and JNI headers.
#
# Produces librtbot_sql_jni.so (Linux) / librtbot_sql_jni.dylib (macOS).
# ---------------------------------------------------------------------------
cc_binary(
    name = "rtbot_sql_jni",
    srcs = ["rtbot_sql_jni.cpp"],
    linkshared = True,
    deps = [
        "//libs/api:api_compiler",
        "//libs/parser",
        "@rtbot//libs/api:rtbot-api",
        "@json-cpp//:lib",
        "@bazel_tools//tools/jdk:jni",
    ],
)

# ---------------------------------------------------------------------------
# Java runtime library — the reusable RTBot SQL Java wrapper
# Package: dev.rtbot.sql
# ---------------------------------------------------------------------------
java_library(
    name = "rtbot-sql-java",
    srcs = glob(["src/main/java/**/*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "@maven//:com_google_code_gson_gson",
    ],
)

# ---------------------------------------------------------------------------
# Integration tests — exercises the full JNI bridge + runtime
# ---------------------------------------------------------------------------
java_test(
    name = "rtbot-sql-java-test",
    srcs = ["src/test/java/dev/rtbot/sql/RtBotSqlRuntimeTest.java"],
    test_class = "dev.rtbot.sql.RtBotSqlRuntimeTest",
    jvm_flags = ["-Djava.library.path=runtimes/java"],
    data = [":rtbot_sql_jni"],
    deps = [
        ":rtbot-sql-java",
        "@maven//:junit_junit",
        "@maven//:com_google_code_gson_gson",
    ],
)

# ---------------------------------------------------------------------------
# Load test — bearing preset throughput benchmark
#
# Measures msgs/sec, memory, and CPU utilization by feeding synthetic
# vibration bursts through the full rotating-machinery preset pipeline.
#
# Run:  bazel test //runtimes/java:bearing-load-test --test_output=all
# ---------------------------------------------------------------------------
java_test(
    name = "bearing-load-test",
    srcs = ["src/test/java/dev/rtbot/sql/BearingLoadTest.java"],
    test_class = "dev.rtbot.sql.BearingLoadTest",
    jvm_flags = ["-Djava.library.path=runtimes/java"],
    data = [":rtbot_sql_jni"],
    timeout = "long",
    deps = [
        ":rtbot-sql-java",
        "@maven//:junit_junit",
        "@maven//:com_google_code_gson_gson",
    ],
)
