load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_java//java:defs.bzl", "java_library", "java_test")

package(default_visibility = ["//visibility:public"])

# ---------------------------------------------------------------------------
# Platform selectors used for native-resource classifier targets.
# ---------------------------------------------------------------------------
config_setting(
    name = "is_linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "is_linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "is_macos_x86_64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "is_macos_aarch64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "is_windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "is_windows_aarch64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:aarch64",
    ],
)

# ---------------------------------------------------------------------------
# JNI shared library — SQL compiler + pipeline execution
#
# Compiles rtbot_sql_jni.cpp against the RTBot SQL compiler API, the RTBot
# core API (for Program / VectorNumberData), nlohmann/json, and JNI headers.
#
# Produces librtbot_sql_jni.so (Linux) / librtbot_sql_jni.dylib (macOS).
# ---------------------------------------------------------------------------
cc_binary(
    name = "rtbot_sql_jni",
    srcs = ["rtbot_sql_jni.cpp"],
    linkshared = True,
    deps = [
        "//libs/api:api_compiler",
        "//libs/api:api_preprocessor",
        "//libs/api:batch_decoder",
        "//libs/parser",
        "@rtbot//libs/api:rtbot-api",
        "@json-cpp//:lib",
        "@bazel_tools//tools/jdk:jni",
    ],
)

# ---------------------------------------------------------------------------
# Native-resource "classifier" artifacts.
#
# These targets stage the JNI library into /native/<platform>/ inside a jar.
# Publish pattern:
#   - rtbot-sql-java            -> core API classes only
#   - rtbot-sql-java-native-*   -> platform-specific native resources
# Consumers include core + exactly one native target matching their platform.
# ---------------------------------------------------------------------------
genrule(
    name = "rtbot_sql_jni_resource_linux_x86_64",
    srcs = [":rtbot_sql_jni"],
    outs = ["native/linux-x86_64/librtbot_sql_jni.so"],
    cmd = "cp $< $@",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

genrule(
    name = "rtbot_sql_jni_resource_linux_aarch64",
    srcs = [":rtbot_sql_jni"],
    outs = ["native/linux-aarch64/librtbot_sql_jni.so"],
    cmd = "cp $< $@",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

genrule(
    name = "rtbot_sql_jni_resource_mac_x86_64",
    srcs = [":rtbot_sql_jni"],
    outs = ["native/mac-x86_64/librtbot_sql_jni.dylib"],
    cmd = "cp $< $@",
    target_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

genrule(
    name = "rtbot_sql_jni_resource_mac_aarch64",
    srcs = [":rtbot_sql_jni"],
    outs = ["native/mac-aarch64/librtbot_sql_jni.dylib"],
    cmd = "cp $< $@",
    target_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

genrule(
    name = "rtbot_sql_jni_resource_win_x86_64",
    srcs = [":rtbot_sql_jni"],
    outs = ["native/win-x86_64/rtbot_sql_jni.dll"],
    cmd = "cp $< $@",
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

genrule(
    name = "rtbot_sql_jni_resource_win_aarch64",
    srcs = [":rtbot_sql_jni"],
    outs = ["native/win-aarch64/rtbot_sql_jni.dll"],
    cmd = "cp $< $@",
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:aarch64",
    ],
)

# ---------------------------------------------------------------------------
# Java runtime library — the reusable RTBot SQL Java wrapper
# Package: dev.rtbot.sql
# ---------------------------------------------------------------------------
java_library(
    name = "rtbot-sql-java",
    srcs = glob(["src/main/java/**/*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "@maven//:com_google_code_gson_gson",
    ],
)

java_library(
    name = "rtbot-sql-java-native-linux-x86_64",
    srcs = [],
    resources = [":rtbot_sql_jni_resource_linux_x86_64"],
    resource_strip_prefix = "runtimes/java",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:public"],
)

java_library(
    name = "rtbot-sql-java-native-linux-aarch64",
    srcs = [],
    resources = [":rtbot_sql_jni_resource_linux_aarch64"],
    resource_strip_prefix = "runtimes/java",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    visibility = ["//visibility:public"],
)

java_library(
    name = "rtbot-sql-java-native-mac-x86_64",
    srcs = [],
    resources = [":rtbot_sql_jni_resource_mac_x86_64"],
    resource_strip_prefix = "runtimes/java",
    target_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:public"],
)

java_library(
    name = "rtbot-sql-java-native-mac-aarch64",
    srcs = [],
    resources = [":rtbot_sql_jni_resource_mac_aarch64"],
    resource_strip_prefix = "runtimes/java",
    target_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
    visibility = ["//visibility:public"],
)

java_library(
    name = "rtbot-sql-java-native-win-x86_64",
    srcs = [],
    resources = [":rtbot_sql_jni_resource_win_x86_64"],
    resource_strip_prefix = "runtimes/java",
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:public"],
)

java_library(
    name = "rtbot-sql-java-native-win-aarch64",
    srcs = [],
    resources = [":rtbot_sql_jni_resource_win_aarch64"],
    resource_strip_prefix = "runtimes/java",
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:aarch64",
    ],
    visibility = ["//visibility:public"],
